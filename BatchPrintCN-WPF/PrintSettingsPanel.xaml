<UserControl x:Class="BatchPrintCN.PrintSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BatchPrintCN"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- U2-4（V4.2.5）：打印设置从独立窗口改为 ContentDialog 的内容面板（07 方案 §4.3）。
         布局：顶＝模板区；中＝左参数卡片列（可滚动，永不裁剪）+ 右实时预览；底＝左「当前生效」灰字 + 取消/确定。
         确定后由宿主（PrintSettingsPanel.ShowAsync）在 Primary 结果时把控件值写回 PrintOptions。 -->
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：模板区（V4.2 从主页移入，U2 按 §4.3 移到弹窗顶部一行） -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource s.TemplateLabel}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13" TextWrapping="NoWrap"/>
                    <Grid Width="170" VerticalAlignment="Center">
                        <ComboBox x:Name="TemplateBox" VerticalAlignment="Center" FontSize="13" ToolTip="{DynamicResource s.TemplateTip}" SelectionChanged="OnTemplateSelected"/>
                        <TextBlock x:Name="TemplateHint" Text="{DynamicResource s.TemplatePlaceholder}" Margin="8,0,26,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" IsHitTestVisible="False" TextWrapping="NoWrap"/>
                    </Grid>
                    <!-- V4.4 三批·修复B：内容是元素的按钮不吃 Styles.xaml 那份默认模板，字色在元素上就地钉回按钮的 Foreground -->
                    <Button x:Name="BtnSaveTemplate" Padding="12,0" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource BtnOutline}" FontSize="13" Click="OnSaveTemplate">
                        <TextBlock Text="{DynamicResource s.SaveTemplate}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="BtnDeleteTemplate" Padding="12,0" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource BtnText}" FontSize="13" Click="OnDeleteTemplate">
                        <TextBlock Text="{DynamicResource s.DeleteTemplate}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{DynamicResource s.TemplateTip}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" MaxWidth="330" TextWrapping="Wrap" TextAlignment="Right"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：设置项分组卡片（ui:Card），超高自动滚动，永不裁剪 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="10" ClipToBounds="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4">
                        <ui:Card Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource s.PsDuplex}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <RadioButton x:Name="SimplexRb" Content="{DynamicResource s.PsSimplex}" Margin="4,4,0,2" Checked="OnAnyChecked"/>
                                <RadioButton x:Name="LongEdgeRb" Content="{DynamicResource s.PsLongEdge}" Margin="4,2,0,2" Checked="OnAnyChecked"/>
                                <RadioButton x:Name="ShortEdgeRb" Content="{DynamicResource s.PsShortEdge}" Margin="4,2,0,2" Checked="OnAnyChecked"/>
                            </StackPanel>
                        </ui:Card>
                        <ui:Card Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource s.PsColorMode}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <RadioButton x:Name="ColorRb" Content="{DynamicResource s.PsColor}" Margin="4,4,0,2" Checked="OnAnyChecked"/>
                                <RadioButton x:Name="BlackWhiteRb" Content="{DynamicResource s.PsBlackWhite}" Margin="4,2,0,2" Checked="OnAnyChecked"/>
                            </StackPanel>
                        </ui:Card>
                        <ui:Card Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource s.PsOrientation}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <RadioButton x:Name="AutoOrientRb" Content="{DynamicResource s.PsAutoOrient}" Margin="4,4,0,2" Checked="OnAnyChecked"/>
                                <RadioButton x:Name="PortraitRb" Content="{DynamicResource s.PsPortrait}" Margin="4,2,0,2" Checked="OnAnyChecked"/>
                                <RadioButton x:Name="LandscapeRb" Content="{DynamicResource s.PsLandscape}" Margin="4,2,0,2" Checked="OnAnyChecked"/>
                            </StackPanel>
                        </ui:Card>
                        <ui:Card Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource s.PsPaper}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="PaperBox" Width="150" Margin="4,4,8,4" SelectionChanged="OnAnyChanged"/>
                                    <TextBlock Text="{DynamicResource s.PsPaperDefault}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                        <!-- F6（V4.3）：奇偶页 -->
                        <ui:Card Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource s.PsParity}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="ParityBox" Width="170" HorizontalAlignment="Left" Margin="4,4,0,2" SelectionChanged="OnAnyChanged"/>
                            </StackPanel>
                        </ui:Card>
                        <!-- F6（V4.3）：纸盒选择（自动 + 当前打印机 PaperSources） -->
                        <ui:Card Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource s.PsPaperSource}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="PaperSourceBox" Width="220" HorizontalAlignment="Left" Margin="4,4,0,2" SelectionChanged="OnAnyChanged"/>
                            </StackPanel>
                        </ui:Card>
                        <ui:Card Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource s.PsPagesPerSheet}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="PagesBox" Width="150" HorizontalAlignment="Left" Margin="4,4,0,2" SelectionChanged="OnAnyChanged"/>
                                <TextBlock Text="{DynamicResource s.PsPagesHint}" Margin="4,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ui:Card>
                        <!-- F6（V4.3）：缩放模式五选 + 自定义百分比 NumberBox -->
                        <ui:Card Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource s.PsScaleMode}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="ScaleModeBox" Width="220" HorizontalAlignment="Left" Margin="4,4,0,2" SelectionChanged="OnScaleModeChanged"/>
                                <StackPanel Orientation="Horizontal" Margin="4,6,0,4">
                                    <TextBlock Text="{DynamicResource s.PsScalePercent}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                                    <ui:NumberBox x:Name="ScaleBox" Width="110" Value="100" Minimum="1" Maximum="400" MaxDecimalPlaces="0"
                                                  SpinButtonPlacementMode="Hidden" VerticalAlignment="Center" TextChanged="OnScaleTextChanged"/>
                                    <TextBlock Text="{DynamicResource s.PsPercentRange}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                        <!-- F6（V4.3）：小册子（骑马订页序，强制 2 版横排；开启时版数/奇偶置灰） -->
                        <ui:Card Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <ui:ToggleSwitch x:Name="BookletBox" Content="{DynamicResource s.PsBooklet}"
                                                 OnContent="{DynamicResource s.ToggleOn}" OffContent="{DynamicResource s.ToggleOff}"
                                                 Checked="OnBookletChanged" Unchecked="OnBookletChanged"/>
                                <TextBlock Text="{DynamicResource s.PsBookletHint}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </ui:Card>
                        <TextBlock Text="{DynamicResource s.PsNote}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="4,10,4,4" FontSize="12"/>
                        <!-- F6（V4.3）：三层优先级提示（⑦ 断言锚点） -->
                        <TextBlock x:Name="PriorityNote" Text="{DynamicResource s.PsPriorityNote}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="4,4,4,4" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧：实时预览 -->
            <Grid Grid.Column="1" Margin="14,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource s.PsPreviewTitle}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                <Border Grid.Row="1" Background="{DynamicResource PreviewAreaBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                    <local:PaperPreviewWpf x:Name="Preview" Margin="12"/>
                </Border>
                <TextBlock Grid.Row="2" x:Name="SummaryText" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </Grid>
        </Grid>

        <!-- 底部页脚（§4.3）：左＝「当前生效」灰字；右＝取消/确定 -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="EffectiveText" Grid.Column="0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnCancel" Content="{DynamicResource s.Cancel}" Style="{StaticResource BtnOutline}" Width="100" Margin="0,0,10,0" Click="OnCancel"/>
                    <Button x:Name="BtnOk" Content="{DynamicResource s.Ok}" Style="{StaticResource BtnPrimary}" Width="100" Click="OnOk"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

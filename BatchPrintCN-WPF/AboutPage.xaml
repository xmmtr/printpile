<UserControl x:Class="BatchPrintCN.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- U2-8（V4.2.5）：关于页——独立/隐私与日志收纳进 WPF-UI CardExpander（07 方案 §4.5；4.3.0 无 SettingsExpander）。
         控件名 LogPathText/BtnOpenLog 保持（修整23 的"日志唯一入口"断言取用）。 -->
    <!-- 两层修整（V4.2.5 修整⑤）：
         ① HorizontalScrollBarVisibility=Disabled——内容按可视区宽度测量（默认 Auto 给"无限宽"约束）；
         ② StackPanel 去掉 HorizontalAlignment=Left——Left 会按最宽子项的自然宽度排列（卡片被收窄"短一截"），
            改默认 Stretch 后铺到 min(可视区宽, MaxWidth 920)。 -->
    <!-- V4.9 版本内修整第二批·修E：顶部旧品牌标题卡整块移除（应用名大字 + 副标题徽标 + 版本行 + 引擎说明行）；
         版本号并入「检查更新」行说明一处；引擎说明行随设置页「转换引擎」块一起退。 -->
    <!-- V4.9.3（49 号开工令）关于页改版，自上而下四块：
         版1 标题区（应用名 + 版本 + 构建信息行）与按钮行（官网 / 打开数据目录 / 打开日志）——
             需求方指定参照布局，标题区因此回归（修E 的"全页不出现应用名"与"版本号恰一处"两条已验收断言就地改判，条目不删）；
             原「日志位置」expander 移除，其职责由本行「打开日志」按钮承接（入口不消失，只是形态升级）。
             59 号令（2026-10-09 需求方拍板）：「GitHub」一枚随闭源口径移除，四按钮改三按钮（原"保留"口径作废，条目不删）。
         版2 自动检查更新（开关 + 说明行）；版3 更新渠道（下拉 + 说明行）；版4 立即检查（按钮 + 内联结果，不再弹 MessageBox）。
         按钮点击失败一律走本行下方的状态文字，不弹任何窗。 -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,0,4,8" MaxWidth="920">

            <!-- 版1·标题区：应用名 + 版本（代码里拼，见 AboutPage.xaml.cs 的 BuildHeaderText） -->
            <StackPanel Margin="2,0,2,10">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="BuildText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 版1·按钮行（WrapPanel：窗口收窄就换行，不顶出横向滚动条——与修整18 同一口径） -->
            <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button x:Name="BtnSite" Content="{DynamicResource s.AboutBtnSite}" Style="{StaticResource BtnOutline}"
                        Height="30" Padding="12,0" Margin="0,0,8,8" Click="OnOpenSite"/>
                <Button x:Name="BtnGitHub" Content="GitHub" Style="{StaticResource BtnOutline}"
                        Height="30" Padding="12,0" Margin="0,0,8,8" Click="OnGitHub"/>
                <Button x:Name="BtnGitee" Content="Gitee" Style="{StaticResource BtnOutline}"
                        Height="30" Padding="12,0" Margin="0,0,8,8" Click="OnGitee"/>
                <Button x:Name="BtnData" Content="{DynamicResource s.AboutBtnData}" Style="{StaticResource BtnOutline}"
                        Height="30" Padding="12,0" Margin="0,0,8,8" Click="OnOpenDataDir"/>
                <Button x:Name="BtnLog" Content="{DynamicResource s.AboutOpenLog}" Style="{StaticResource BtnOutline}"
                        Height="30" Padding="12,0" Margin="0,0,0,8" Click="OnOpenLog"/>
            </WrapPanel>
            <!-- 三枚按钮的结果行：成功/失败都只在这一行说一句话（不弹模态） -->
            <TextBlock x:Name="LinkNoteText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="2,0,2,10"/>

            <!-- 版2·自动检查更新（开关 + 说明行；关掉之后只剩手动「立即检查」） -->
            <ui:CardControl Padding="16,12" Margin="0,4,0,0">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="20"/>
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource s.AboutAutoTitle}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource s.AboutAutoDesc}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <!-- Wpf.Ui 4.3 的 ToggleSwitch 继承自 ToggleButton：状态是 IsChecked、事件是 Checked/Unchecked（没有 IsOn/Toggled） -->
                <ui:ToggleSwitch x:Name="TglAutoCheck" HorizontalAlignment="Right"
                                 Checked="OnAutoCheckChanged" Unchecked="OnAutoCheckChanged"/>
            </ui:CardControl>

            <!-- 版3·更新渠道：52 号令·返修②（2026-10-06 需求方拍板）整卡移除——不再向用户暴露 stable/preview 选择。
                 UpdateChannel 逻辑锁定 stable（AutoUpdate/AboutPage 恒按正式版渠道比较），settings.json 的 UpdateChannel 键
                 保留读取兼容（存量 preview 读取后按 stable 行为），见 SettingsService 报备注释。
                 版4·立即检查（按钮 + 右侧内联结果区；48 号的 MessageBox 呈现退役，文案与分类一行未改） -->
            <ui:CardControl x:Name="UpdateCard" Padding="16,12" Margin="0,8,0,0">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="20"/>
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <!-- 68 号 T3（需求十）：这一列原来会被右侧内联长文本挤成"一字一行"——Header 列给 MinWidth 护住标题，
                         右侧内容列给 MaxWidth 封顶（两处都是判据，自检在 960／1120／1400 三档窗宽×中英双语实测）。 -->
                    <StackPanel x:Name="UpdateHeaderPanel" MinWidth="230">
                        <TextBlock x:Name="UpdateTitleText" Text="{DynamicResource s.AboutUpdateTitle}" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                        <TextBlock x:Name="UpdateDescText" Text="{DynamicResource s.AboutUpdateDesc}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel HorizontalAlignment="Right" MinWidth="240" MaxWidth="300">
                    <!-- 按钮仍贴卡片右缘（V4.7 修整2 那条几何断言原样成立）；内联结果左对齐排在按钮下方 -->
                    <Button x:Name="BtnCheckUpdate" Content="{DynamicResource s.AboutUpdateBtn}" Style="{StaticResource BtnOutline}"
                            Height="30" Padding="12,0" HorizontalAlignment="Right" Click="OnCheckUpdate"/>
                    <!-- 内联结果：检查中…／已是最新／发现新版本／失败分类文案（原文只进日志，绝不上屏） -->
                    <TextBlock x:Name="UpdateResultText" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="Collapsed" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <!-- 「发现新版本」时才出现的小按钮（点开下载页前再过一次白名单） -->
                    <Button x:Name="BtnOpenDownload" Content="{DynamicResource s.UpdateOpenDownloadBtn}" Style="{StaticResource BtnText}"
                            FontSize="12" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Right"
                            Visibility="Collapsed" Click="OnOpenDownload"/>
                </StackPanel>
            </ui:CardControl>

            <!-- V4.9-2 → 修C：问题反馈不再由客户端直发，这一行改成"跳官网反馈页"；52 号令·返修③（2026-10-06）：
                 头部新增勾选「反馈时自动打包日志上传」（默认勾、可关、settings FeedbackAutoLogs 键持久化）——
                 勾选时跳转前把日志目录打包 zip 直传站点 /api/feedback/logs 拿短期 key、URL 带 logpkg 与反馈单关联；
                 失败静默降级走旧行为（跳转＋复制日志路径）。勾选下方小字＝本地信息说明（开工令口径）。 -->
            <ui:CardControl Padding="16,12" Margin="0,8,0,0">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Chat24" FontSize="20"/>
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource s.FbEntryTitle}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource s.FbEntryDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <CheckBox x:Name="CbkAutoLogs" Content="{DynamicResource s.FbAutoLogsTitle}" FontSize="12"
                                  Margin="0,6,0,0" Checked="OnAutoLogsChanged" Unchecked="OnAutoLogsChanged"/>
                        <TextBlock Text="{DynamicResource s.FbAutoLogsDesc}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock x:Name="FeedbackNoteText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <Button x:Name="BtnFeedback" Content="{DynamicResource s.FbEntryBtn}" Style="{StaticResource BtnOutline}"
                        Height="30" Padding="12,0" HorizontalAlignment="Right" Click="OnFeedback"/>
            </ui:CardControl>

            <!-- 78 号令·B3：关于页收口——「功能一览」整块（标题/导语/三行）连同五枚资源键一并删除，
                 本卡只留一行 GPLv3 开源声明。2026-10-16 需求方调整：GitHub／Gitee 两按钮移至顶部
                 按钮行（官网按钮右侧），本卡不再放按钮。 -->
            <ui:CardControl x:Name="FeatureCard" Padding="16,12" Margin="0,8,0,0">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="20"/>
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <!-- 73 号令 Rule 5：关于页同步一行开源声明（全文见随包 LICENSE） -->
                    <TextBlock x:Name="LicenseLineText" Text="{DynamicResource s.AboutLicenseLine}" FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </ui:CardControl.Header>
            </ui:CardControl>

            <!-- 独立性与隐私（展开收纳）——修E：标题不再借用应用名 -->
            <ui:CardExpander ContentPadding="16,12,16,12" Padding="16,12" Margin="0,8,0,0">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="Info20" FontSize="20"/>
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <TextBlock Text="{DynamicResource s.AboutIndependenceTitle}" FontSize="14" FontWeight="SemiBold"/>
                </ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Text="{DynamicResource s.AboutIndependent}" FontSize="13"/>
                    <TextBlock Text="{DynamicResource s.AboutPrivacy}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                </StackPanel>
            </ui:CardExpander>

            <!-- V4.9.3（49 号·版1）：原「日志位置」expander（LogPathText + BtnOpenLog）整块移除，
                 由顶部三按钮行的「打开日志」承接——应用内到达日志文件夹的入口没有消失，只是从"展开再点"升成一步点。
                 41 号修E 那条"日志位置保留为唯一入口"的已验收断言就地改判为"日志按钮承接"（条目不删）。 -->

        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="BatchPrintCN.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- U2-8（V4.2.5）：关于页——应用信息卡保持，独立/隐私与日志收纳进 WPF-UI CardExpander（07 方案 §4.5；
         4.3.0 无 SettingsExpander，用 CardExpander 对应实现）。控件名 VersionText/LogPathText/BtnOpenLog 保持。 -->
    <!-- 两层修整（V4.2.5 修整⑤）：
         ① HorizontalScrollBarVisibility=Disabled——内容按可视区宽度测量（默认 Auto 给"无限宽"约束）；
         ② StackPanel 去掉 HorizontalAlignment=Left——Left 会按最宽子项的自然宽度排列（卡片被收窄"短一截"），
            改默认 Stretch 后铺到 min(可视区宽, MaxWidth 920)。 -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,0,4,8" MaxWidth="920">

            <!-- 应用信息 -->
            <Border Style="{StaticResource CardBorder}" Padding="20,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="12" Height="12" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource s.AppTitle}" FontSize="20" FontWeight="Bold"/>
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource s.AppSubtitle}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Text="{DynamicResource s.AboutEngine}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- V4.7 修整2：检查更新（手动点击，不做启动提示）——图标+标题+说明在左，按钮钉最右（与设置页修整1 同一写法） -->
            <ui:CardControl Padding="16,12" Margin="0,12,0,0">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="20"/>
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource s.AboutUpdateTitle}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource s.AboutUpdateDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <Button x:Name="BtnCheckUpdate" Content="{DynamicResource s.AboutUpdateBtn}" Style="{StaticResource BtnOutline}"
                        Height="30" Padding="12,0" HorizontalAlignment="Right" Click="OnCheckUpdate"/>
            </ui:CardControl>

            <!-- 独立性与隐私（展开收纳） -->
            <ui:CardExpander ContentPadding="16,12,16,12" Padding="16,12" Margin="0,12,0,0">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="Info20" FontSize="20"/>
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <TextBlock Text="{DynamicResource s.AppTitle}" FontSize="14" FontWeight="SemiBold"/>
                </ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Text="{DynamicResource s.AboutIndependent}" FontSize="13"/>
                    <TextBlock Text="{DynamicResource s.AboutPrivacy}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                </StackPanel>
            </ui:CardExpander>

            <!-- 日志位置 -->
            <ui:CardExpander ContentPadding="16,12,16,12" Padding="16,12" Margin="0,8,0,0">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="Folder20" FontSize="20"/>
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <TextBlock Text="{DynamicResource s.AboutLogs}" FontSize="14" FontWeight="SemiBold"/>
                </ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock x:Name="LogPathText" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <Button x:Name="BtnOpenLog" Content="{DynamicResource s.AboutOpenLog}" Style="{StaticResource BtnOutline}" Width="130" HorizontalAlignment="Left" Click="OnOpenLog"/>
                </StackPanel>
            </ui:CardExpander>

        </StackPanel>
    </ScrollViewer>
</UserControl>

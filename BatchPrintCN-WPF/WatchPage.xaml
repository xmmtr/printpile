<UserControl x:Class="BatchPrintCN.WatchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 72 号令（V1.1.0·F7）：「监视」页——位于导航「历史」与「设置」之间；73 号令起为普通功能页（无引导态、无置灰）。
         列宽口径沿用 61/修整21a（最小窗 960 内层可视约 694）：固定列 44＋150＋180＋110＝484，星号列保底 150 ⇒ 合计 634 不出横向滚动条；
         「打印后动作」不单列（进「参数」摘要与悬浮提示），列数一少，六项规则字段才塞得进同一排。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏：左＝标题＋计数，右＝新建/编辑/删除（单排 Grid，与历史页 61 号口径一致，永不折行） -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{DynamicResource s.WatchTitle}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
            </StackPanel>
            <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnAdd" Grid.Column="0" Content="{DynamicResource s.WatchAdd}" Height="30" Padding="10,0" FontSize="12"
                        Margin="0,0,6,0" Style="{StaticResource BtnPrimary}" Click="OnAdd"/>
                <Button x:Name="BtnEdit" Grid.Column="1" Content="{DynamicResource s.WatchEdit}" Height="30" Padding="10,0" FontSize="12"
                        Margin="0,0,6,0" Style="{StaticResource BtnOutline}" Click="OnEdit"/>
                <Button x:Name="BtnDelete" Grid.Column="2" Content="{DynamicResource s.WatchDelete}" Height="30" Padding="10,0" FontSize="12"
                        Style="{StaticResource BtnDangerPlain}" Click="OnDelete"/>
            </Grid>
        </Grid>

        <!-- 一句话说明（与工具栏之间留一行，不进列表） -->
        <TextBlock Grid.Row="1" Text="{DynamicResource s.WatchDesc}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>

        <!-- 规则列表（73 号令起常驻：不再有引导态） -->
        <Border x:Name="ListCard" Grid.Row="2" Style="{StaticResource CardBorder}" ClipToBounds="True">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      SelectionMode="Single" RowHeaderWidth="0" HeadersVisibility="Column"
                      RowHeight="36" UseLayoutRounding="True" SnapsToDevicePixels="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      CanUserResizeColumns="False" ColumnHeaderStyle="{StaticResource NoGripHeader}"
                      RowStyle="{StaticResource GridRowLine}" CellStyle="{StaticResource GridCellLine}"
                      GridLinesVisibility="None" BorderThickness="0.5"
                      BorderBrush="{DynamicResource GridLineBrush}"
                      MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.Columns>
                    <!-- ① 启用开关：直接写回规则并落盘（多规则独立启停）；样式与主列表表头勾选框同口径（Padding 0 居中） -->
                    <DataGridTemplateColumn Width="44" MinWidth="44" CanUserSort="False" CanUserResize="False">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource s.WatchColEnabled}" TextWrapping="NoWrap" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="0" Margin="0"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Click="OnToggleEnabled"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding Name}" Width="150" MinWidth="120" ElementStyle="{StaticResource CellTextTip}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource s.WatchColName}" TextWrapping="NoWrap"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Folder}" Width="180" MinWidth="140" ElementStyle="{StaticResource CellTextTip}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource s.WatchColFolder}" TextWrapping="NoWrap"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <!-- 参数摘要＝类型/时段/打印机/模板/打印后五项拼一行（悬浮看逐档全名）；这一列吃满剩余宽度 -->
                    <DataGridTextColumn x:Name="ColParams" Binding="{Binding Params}" Width="*" MinWidth="150" ElementStyle="{StaticResource CellTextTip}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource s.WatchColParams}" TextWrapping="NoWrap"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <!-- 状态列：目录有问题＝黄字（这一条当下不监视）；正常＝本轮已触发次数＋最近文件名 -->
                    <DataGridTemplateColumn Width="110" MinWidth="110" CanUserSort="False">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource s.WatchColState}" TextWrapping="NoWrap"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- 上色走 DataTrigger＋DynamicResource（不暴露 Brush 属性）：切主题即时跟随，不必等本页刷新 -->
                                <TextBlock Text="{Binding State}" ToolTip="{Binding State}" FontSize="12" VerticalAlignment="Center"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Problem}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource StatusWarnTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 空态（列表卡片之上，不挡交互；与历史页 EmptyText 同一口径） -->
        <TextBlock x:Name="EmptyText" Grid.Row="2" Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                   MaxWidth="420" Visibility="Collapsed" IsHitTestVisible="False"
                   Text="{DynamicResource s.WatchEmpty}"/>
    </Grid>
</UserControl>

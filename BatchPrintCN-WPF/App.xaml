<Application x:Class="BatchPrintCN.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- U1 换皮（需求方指示：UI 样式对齐 WPF-UI，我们自己的模板让位）。
                     WPF-UI 必须最先合并：Styles.xaml 里的按钮样式用 BasedOn="{StaticResource {x:Type Button}}"
                     继承它的隐式模板，资源得先存在才解析得到。
                     本文件同批删除了我们与 WPF-UI 冲突的隐式控件样式（TextBox/PasswordBox/ComboBox/
                     ComboBoxItem/RadioButton/DataGrid/ScrollBar/ScrollViewer/ProgressBar 全部交给 WPF-UI）。 -->
                <ui:ControlsDictionary />
                <ui:ThemesDictionary Theme="Light" />
                <ResourceDictionary Source="Styles.xaml"/>
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>
                <ResourceDictionary Source="Localization/zh-CN.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<UserControl x:Class="BatchPrintCN.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- U2-7（V4.2.5）：设置页改 WPF-UI 卡片行列表（07 方案 §4.5）。
         WPF-UI 4.3.0 没有 SettingsCard/SettingsExpander（反射实测），对应物为 CardControl/CardExpander：
         简单行＝CardControl（图标+标题+说明+右侧控件）；可展开行＝CardExpander（收纳目录/状态明细）。
         开关用 ToggleSwitch（On/Off 状态字走 s.ToggleOn/s.ToggleOff），语言/主题用 ComboBox。 -->
    <!-- V4.7 修整1（行内按钮一律钉最右）：卡片行里"文字 + 按钮"混排会让按钮贴着文字停在中间，
         所以含按钮的行统一改 Grid 两/三列（标签 Auto + 文字/路径 * + 按钮 Auto + HorizontalAlignment=Right）；
         新增带按钮的行请照这个写法，别再用 StackPanel 横排。 -->
    <!-- 同关于页修整：Disabled 约束可视区宽 + StackPanel Stretch 铺满（上限 920） -->
    <!-- V4.9 版本内修整第二批·修D（需求方拍板"设置太多找不到重点"）：四块整体移除——
         ① 转换引擎（EngineBox / EngineStatusText / BtnReDetect）：引擎固定走默认「自动」（有本机 WPS/Office 用 COM，
            没有则用 MiniPdf），探测与兜底逻辑一行没动，只是不再让用户手选、也不再显示探测结果；
         ② 验证落盘（打印输出目录 / 保留转换产物开关 / 转换产物目录）：各目录回到既有默认便携目录（程序目录\printout\），
            「保留转换产物」固定为默认关；
         ③ 输出位置（统计 CSV 目录行）：CSV 仍写到既有默认目录（＝日志目录），开关本身保留在「打印统计」行；
         ④ 其他（本机数据目录展示）：路径信息不再在设置页重复（诊断弹窗与关于页日志行都还能拿到）。
         settings.json 里这批旧键（Engine / ReportDirectory / KeepConvertedPdf / ConvertOutputDirectory / PrintoutDirectory）
         读取即忽略、下次保存自然消失（不迁移、不报错，与 V4.8-1 处理 ApiBase 同一口径）。
         删除后不留空卡片：末行「打印统计」底部间距归零，整页只剩 打印机 / 语言 / 外观 / 关闭行为 / 打印统计 五行。 -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,0,4,8" MaxWidth="920">

            <!-- F15（V4.3）：打印机（与主页同一 settings 键双向同步 + 打开系统打印机属性） -->
            <ui:CardControl Padding="16,12" Margin="0,0,0,8">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Print24" FontSize="20"/>
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource s.SettingsPrinterTitle}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource s.SettingsPrinterNote}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ComboBox ItemTemplate="{StaticResource ComboTextTemplate}" x:Name="PrinterBox2" MinWidth="150" ToolTip="{DynamicResource s.SettingsPrinterDesc}" SelectionChanged="OnPrinterChanged"/>
                    <Button x:Name="BtnOpenPrinterProps" Content="{DynamicResource s.SettingsPrinterProps}" Style="{StaticResource BtnOutline}" Margin="10,0,0,0" Click="OnOpenPrinterProps"/>
                </StackPanel>
            </ui:CardControl>

            <!-- 语言 -->
            <ui:CardControl Padding="16,12" Margin="0,0,0,8">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Globe20" FontSize="20"/>
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource s.SettingsLanguage}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource s.SettingsLanguageDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox ItemTemplate="{StaticResource ComboTextTemplate}" x:Name="LangBox" MinWidth="150" SelectionChanged="OnLangChanged">
                    <ComboBoxItem Content="{DynamicResource s.LangZh}"/>
                    <ComboBoxItem Content="{DynamicResource s.LangEn}"/>
                </ComboBox>
            </ui:CardControl>

            <!-- 52 号令·步骤 4（2026-10-06 需求方拍板）：原「外观模式」下拉替换为「主题」卡——
                 色卡网格（内置 8 主题，三段缩略色块，与原型 04-产出交付\演示\主题系统原型-20261005.html 同形态）
                 ＋获取更多主题（占位提示）。色卡由代码生成（ThemeCardHost），
                 选择即时全模块换肤并持久化（ThemeName 键）。令牌制换肤：主题只换语义色值，不做控件级样式注入。
                 56 号令（2026-10-07 需求方拍板）：「导入主题包」「打开主题文件夹」撤下（暂时不需要，
                 主题只从官网获取；ThemeService.Import 解析引擎保留，官网主题库上线时恢复入口）。 -->
            <Border x:Name="ThemeCard" Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Symbol="PaintBrush20" FontSize="20" VerticalAlignment="Center"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource s.SettingsTheme}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource s.SettingsThemeDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <WrapPanel x:Name="ThemeCardHost" Margin="0,0,0,4"/>
                    <WrapPanel Margin="0,6,0,0">
                        <Button x:Name="BtnMoreThemes" Content="{DynamicResource s.ThemeMoreBtn}" Style="{StaticResource BtnPrimary}"
                                Height="30" Padding="12,0" FontSize="12" Margin="0,0,0,6" Click="OnMoreThemes"/>
                        <TextBlock x:Name="ThemeNoteText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,6" TextWrapping="NoWrap"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- V4.9-1：关闭行为三选。V4.9 版本内修整第二批·修A：第二项语义升级为「最小化到托盘」
                 （settings.json 键值仍是 ask|minimize|exit，老配置兼容；minimize 现在＝窗口 Hide + 托盘图标在场）。
                 沿用本页语言·外观同一写法：ComboBox + SelectedIndex 映射枚举，改动即存。
                 80 号令（V1.2.1）：同一张卡底部加第二行「开机自启动」——开关语义与生命周期同属一卡，
                 且不新增第六张卡（V49b 那条"恰好五张卡片"的断言因此继续成立）。两行都用 Grid（标签 * ＋ 控件 Auto），
                 控件一律贴卡片右缘，与 V4.7 修整1"行内控件钉最右"同一口径。 -->
            <ui:CardControl Padding="16,12" Margin="0,0,0,8">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="20"/>
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource s.SettingsCloseTitle}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource s.SettingsCloseDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemTemplate="{StaticResource ComboTextTemplate}" x:Name="CloseBox"
                                      MinWidth="150" VerticalAlignment="Center" HorizontalAlignment="Right"
                                      SelectionChanged="OnCloseBehaviorChanged">
                                <ComboBoxItem Content="{DynamicResource s.CloseAsk}"/>
                                <ComboBoxItem Content="{DynamicResource s.CloseMinimize}"/>
                                <ComboBoxItem Content="{DynamicResource s.CloseExit}"/>
                            </ComboBox>
                        </Grid>
                        <!-- 80 号令·开机自启动：默认关；开＝写 HKCU 的 Run 值（值名 PrintPile，数据＝带引号 exe 全路径），
                             关＝删值；每次启动再按 settings.json 里的意图对齐一次（AutoStart.SyncOnStartup）。 -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource s.SettingsAutoStartTitle}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource s.SettingsAutoStartNote}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <!-- Wpf.Ui 4.3 的 ToggleSwitch 继承 ToggleButton：状态是 IsChecked、事件是 Checked/Unchecked -->
                            <ui:ToggleSwitch Grid.Column="1" x:Name="AutoStartBox" VerticalAlignment="Center" HorizontalAlignment="Right"
                                             Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"/>
                        </Grid>
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>

            <!-- 打印统计（R3）：开关用 ToggleSwitch。修D 之后这一行是本页末行（底部间距归零，不留空白区）；
                 统计 CSV 的落盘目录不再提供选择，固定用既有默认目录（＝日志目录）。 -->
            <ui:CardControl Padding="16,12" Margin="0,0,0,0">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="DataUsage20" FontSize="20"/>
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource s.SettingsReport}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource s.SettingsReportDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ReportEnableBox" Content="{DynamicResource s.SettingsReportEnable}"
                                 OnContent="{DynamicResource s.ToggleOn}" OffContent="{DynamicResource s.ToggleOff}"
                                 Margin="0,0,0,0" Checked="OnReportChecked" Unchecked="OnReportChecked"/>
            </ui:CardControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>

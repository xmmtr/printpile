<Project>

  <!-- M3 版本与配置集中管理（2026-09-18，05-优化方案-v4.2.3）
       版本号一处改、三工程全生效；各 csproj 不再单独写 Version/FileVersion。
       NOTICE 里的版本仍手工写，由自检断言核对两者一致。
       V4.7：从主版本线分叉整理的独立版本。
       V4.8：版本内演进（33 号升级计划）——检查更新默认路由切生产后端（V4.8-1）。 -->
  <PropertyGroup>
    <Version>4.8.0</Version>
    <AssemblyVersion>4.8.0.0</AssemblyVersion>
    <FileVersion>4.8.0.0</FileVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Company>批量打印助手开发组</Company>
    <Product>批量打印助手</Product>
    <Copyright>Copyright © 2026 批量打印助手开发组</Copyright>
    <!-- 守护：警告即失败（方案 §M6 断言③）。若将来引入新分析器告警，先修再放行，不用 #pragma 压。 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>

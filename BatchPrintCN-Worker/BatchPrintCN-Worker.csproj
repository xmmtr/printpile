    <ProjectReference Include="..\BatchPrintCN.Core\BatchPrintCN.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MiniPdf" Version="0.42.0" />
  </ItemGroup>
</Project>
